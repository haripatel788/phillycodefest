# Optional free-tier LLM provider (recommended)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=https://your-app-url.example

# Optional alternate free-tier provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OCR API key (defaults to OCR.space demo key if unset)
OCR_SPACE_API_KEY=
